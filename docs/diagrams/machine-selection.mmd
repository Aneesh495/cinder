flowchart TD
  IR[Verified typed CFG and SSA] --> EDGE[Split every conditional phi edge]
  EDGE --> SELECT[Select integer and SSE operation forms]
  SELECT --> OWN[Own operands phi vectors and terminators]
  SELECT --> BANK[Build definition bank and type table]
  SELECT --> CONTRACT[Declare fixed operands and clobber masks]
  SELECT --> ABI[Select SysV layouts and complete ABI byte programs]
  SELECT --> STORAGE[Select memory address and value roles, byte forms and bitfield operations]
  SELECT --> CONVERT[Select integer floating and boolean conversions]
  SELECT --> ADDRESS[Select frame and RIP-relative addresses, scaled offsets and signed differences]
  SELECT --> MATERIAL[Select literal bits value copies and floating sign changes]
  SELECT --> BULK[Select zero and copy extents and byte programs]
  SELECT --> MARKER[Explicit zero-emission lifetime and phi markers]
  SELECT --> CONTROL[Select branches traps and ABI return forms]
  OWN --> VERIFY[Verify sealed selected representation]
  BANK --> VERIFY
  CONTRACT --> VERIFY
  ABI --> VERIFY
  STORAGE --> VERIFY
  CONVERT --> VERIFY
  ADDRESS --> VERIFY
  CONTROL --> VERIFY
  MATERIAL --> VERIFY
  BULK --> VERIFY
  MARKER --> VERIFY
  VERIFY --> LIVE[CFG liveness and linear-scan allocation]
  BANK --> LIVE
  CONTRACT --> LIVE
  LIVE --> COPY[Own physical edge-copy schedules and register banks]
  LIVE --> FRAME[Select physical frame entry preservation and exit programs]
  COPY --> TOKENS[Independently simulate storage tokens and cycle temporaries]
  TOKENS --> ENCODE[Replay selected operations, ABI programs and physical frame patches]
  ABI --> ENCODE
  STORAGE --> ENCODE
  CONVERT --> ENCODE
  ADDRESS --> ENCODE
  CONTROL --> ENCODE
  MATERIAL --> ENCODE
  BULK --> ENCODE
  FRAME --> ENCODE
  ENCODE --> ELF[Original ELF writer]
  ELF --> CHECK[Independent object and native result checks]
